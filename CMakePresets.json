{
  "version": 5,
  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-debug", "inherits": "base", "generator": "Ninja", "cacheVariables": { "FK_WERROR": "ON" } },
    { "name": "linux-coverage", "inherits": "base", "generator": "Ninja",
      "cacheVariables": { "FK_WERROR": "ON", "FK_COVERAGE": "ON" } },
    { "name": "linux-asan", "inherits": "base", "generator": "Ninja",
      "cacheVariables": { "FK_WERROR": "ON", "FK_SANITIZE": "ON", "CMAKE_C_COMPILER": "clang" } },
    { "name": "windows-msvc", "inherits": "base", "generator": "Visual Studio 17 2022",
      "cacheVariables": { "FK_WERROR": "ON" } },
    { "name": "macos", "inherits": "base", "generator": "Unix Makefiles", "cacheVariables": { "FK_WERROR": "ON" } },
    { "name": "web", "inherits": "base", "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FK_WERROR": "ON" } }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "web", "configurePreset": "web" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "inherits": "base", "configurePreset": "linux-debug" },
    { "name": "linux-coverage", "inherits": "base", "configurePreset": "linux-coverage" },
    { "name": "linux-asan", "inherits": "base", "configurePreset": "linux-asan", "filter": { "include": { "label": "unit" } } },
    { "name": "windows-msvc", "inherits": "base", "configurePreset": "windows-msvc", "configuration": "Debug",
      "filter": { "include": { "label": "unit" } } },
    { "name": "macos", "inherits": "base", "configurePreset": "macos", "filter": { "include": { "label": "unit" } } }
  ]
}
